{
  "name": "victory-road-wiki",
  "private": true,
  "version": "1.0.0",
  "description": "이나즈마 스테이션 - 빅토리 로드 대백과 및 전술판",
  "author": "yangjunhyuk333",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "node scripts/deploy.mjs",
    "electron:start": "electron .",
    "electron:app": "npm run build && electron .",
    "electron:build": "node scripts/build_electron.mjs"
  },
  "build": {
    "appId": "com.inazumastation.app",
    "productName": "이나즈마 스테이션",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/logo.png"
    ],
    "win": {
      "target": "portable",
      "icon": "public/logo.png"
    }
  },
  "dependencies": {
    "firebase": "^12.10.0",
    "google-translate-api-x": "^10.7.2",
    "lucide-react": "^0.575.0",
    "puppeteer": "^24.37.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "es-hangul": "^2.3.8",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "gh-pages": "^6.3.0",
    "globals": "^15.11.0",
    "p-limit": "^7.3.0",
    "vite": "^5.4.10",
    "wanakana": "^5.3.1"
  }
}
