rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 커뮤니티 게시판 (posts 컬렉션) 보안 규칙
    match /posts/{postId} {
      // 읽기(목록 조회 및 상세 보기)는 로그인 여부와 무관하게 모든 방문자에게 허용합니다.
      allow read: if true;
      
      // 게시글 생성은 오직 로그인한 인증된 사용자만 가능합니다.
      allow create: if request.auth != null;
      
      // 게시글 수정 및 삭제는 해당 게시글을 직접 작성한 작성자 본인(authorUid)만 가능합니다.
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    // 2. 나만의 전술판 (tactics 컬렉션) 보안 규칙
    match /tactics/{tacticsId} {
      // 본인이 작성한 전술 데이터만 읽고 쓸 수 있도록 제어합니다.
      // (조회 시 userUid == 로그인한 uid 인 조건의 쿼리만 허용됨)
      allow read: if request.auth != null && request.auth.uid == resource.data.userUid;
      
      // 전술 저장 시 작성자 uid와 로그인 세션의 uid가 일치해야 합니다.
      allow create: if request.auth != null && request.resource.data.userUid == request.auth.uid;
      
      // 전술 수정 및 삭제 역시 작성자 본인만 수행 가능합니다.
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userUid;
    }

    // 3. 포메이션 좌표 대형 (formations 컬렉션) 보안 규칙
    match /formations/{formationId} {
      // 본인이 저장한 포메이션 데이터만 읽을 수 있습니다.
      allow read: if request.auth != null && request.auth.uid == resource.data.userUid;
      
      // 포메이션 저장 시 작성자 uid와 로그인 세션의 uid가 일치해야 합니다.
      allow create: if request.auth != null && request.resource.data.userUid == request.auth.uid;
      
      // 포메이션 수정 및 삭제 역시 작성자 본인만 수행 가능합니다.
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userUid;
    }
  }
}
